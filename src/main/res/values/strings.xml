    <!-- NexusCpActivity - About screen -->
    <string name="carplay_for_your_car">CarPlay, integrated into your car</string>
    <string name="about_description">Standalone CarPlay receiver for Android head units. Both wired and wireless connections are handled locally with local authentication. Regular iPhones connect without jailbreaking, Mac, adapters, or login.\n\nThis preview uses experimental accessory identity. Compatibility with every iPhone and head unit is still being tested. It is not an Apple certified product.</string>
    <string name="open_source_license">Open Source License</string>
    <string name="license_info">Nexus CP is licensed under GPL-3.0.\n\nIncludes AndroidX, Bouncy Castle, JmDNS, and SLF4J. Source and license notices are included with each release.\n\nCarPlay and the CarPlay icon are trademarks of Apple Inc. Nexus CP is an independent project.</string>

